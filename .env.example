# Copy to .env and set real values. Never commit .env.
POSTGRES_DB=onegov
POSTGRES_USER=onegov
# Avoid ';' and '$' in the password (it is embedded in a connection string and read by Compose).
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL. 5433 avoids Windows/Hyper-V reserved ranges that block 5432.
POSTGRES_PORT=5433

# Docker Compose only (all optional)
API_PORT=5080
WEB_PORT=8080
# "Development" enables sample-data seeding and the API reference page. Use Production for anything shared.
ASPNETCORE_ENVIRONMENT=Development

# Secret used to sign access tokens. Required outside Development (at least 32 characters).
# In Development, leave it empty and the API generates a temporary key at each start.
JWT_SIGNING_KEY=
