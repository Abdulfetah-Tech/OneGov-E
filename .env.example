# Copy to .env and set real values. Never commit .env.
POSTGRES_DB=onegov
POSTGRES_USER=onegov
# Avoid ';' and '$' in the password (it is embedded in a connection string and read by Compose).
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Docker Compose only (all optional)
API_PORT=5080
WEB_PORT=8080
# "Development" enables sample-data seeding and the API reference page. Use Production for anything shared.
ASPNETCORE_ENVIRONMENT=Development
