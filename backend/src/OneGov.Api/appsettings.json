{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=onegov;Username=onegov"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Jwt": {
    "Issuer": "onegov",
    "Audience": "onegov-web",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14,
    "RefreshTokenMaxAgeDays": 30
  },
  "NationalId": {
    "Provider": "none",
    "RedirectUri": "http://localhost:4200/auth/national-id/callback"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "AuthPermitLimit": 10
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  }
}
